      "alias_format": "SC 0.xxx PC 0.xxx"
    }
  },
  "schedule_and_inspection": {
    "planned_task_window_hours": "3-24",
    "light_check_max_interval_hours": 4,
    "no_tight_60s_polling": true
  }
